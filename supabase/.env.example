# ============================================================================
# Digital Madrasa — Edge Function secrets
# ============================================================================
#
# These values NEVER reach the app bundle. They are read only by Deno Edge
# Functions running on Supabase's servers.
#
# Local development:
#   cp .env.example .env          # supabase/.env is gitignored
#   supabase functions serve --env-file supabase/.env
#
# Deploying — set them on the project, not in a file:
#   supabase secrets set MPESA_CONSUMER_SECRET=... --project-ref <ref>
#   supabase secrets list
#
# Rotate quarterly. If a value here is ever pasted into apps/mobile/.env,
# treat it as compromised and rotate immediately — a published bundle cannot
# be recalled.
# ============================================================================

# --- Supabase ---------------------------------------------------------------
# service_role bypasses every RLS policy. It is the most dangerous string in
# the project. Server-side only, always.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_DB_URL=

# --- M-Pesa Daraja ----------------------------------------------------------
# sandbox | production
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Public HTTPS URL of the mpesa-callback function. Daraja rejects http and
# will not call localhost — use a tunnel when testing locally.
MPESA_CALLBACK_URL=

# --- Transactional mail (Resend) --------------------------------------------
RESEND_API_KEY=
MAIL_FROM_ADDRESS=noreply@digitalmadrasa.co.ke
MAIL_FROM_NAME=Digital Madrasa

# --- SMS fallback (Africa's Talking) ----------------------------------------
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# --- AI (tajweed evaluation) ------------------------------------------------
ANTHROPIC_API_KEY=
# Stored on every tajweed_feedback row so past results stay interpretable
# after a model change.
TAJWEED_MODEL_VERSION=claude-opus-5

# --- Monitoring -------------------------------------------------------------
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# --- Push notifications -----------------------------------------------------
# Only needed if you enable Expo's enhanced push security.
EXPO_ACCESS_TOKEN=
