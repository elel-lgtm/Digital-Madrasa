# AI gateway configuration.
#
# There is deliberately NO privileged database key here. The gateway reads the
# database as the calling user so that RLS decides what each question can see.
# Adding a privileged key would silently disable every policy in the project.

PORT=8787

# Same values the mobile app uses. The anon key carries no privileges of its own.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# "stub" answers from retrieved data with no model — use it to test auth and
# RLS before Ollama is installed. "ollama" talks to the real model.
MODEL_PROVIDER=stub
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:1.7b
MODEL_TIMEOUT_MS=90000

AI_RATE_LIMIT_PER_MINUTE=10
