{
  "name": "digital-madrasa",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "mobile": "npm run start --workspace @digital-madrasa/mobile",
    "mobile:android": "npm run android --workspace @digital-madrasa/mobile",
    "mobile:ios": "npm run ios --workspace @digital-madrasa/mobile",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "lint": "npm run lint --workspaces --if-present",
    "secret-scan": "node scripts/secret-scan.mjs",
    "db:run": "node scripts/db-run.mjs",
    "db:migrate": "node scripts/db-run.mjs supabase/migrations/*.sql",
    "db:verify": "node scripts/db-run.mjs supabase/tests/verify_core_guarantees.sql",
    "auth:config": "node scripts/auth-config.mjs",
    "auth:config:apply": "node scripts/auth-config.mjs --apply",
    "db:verify:subs": "node scripts/db-run.mjs supabase/tests/verify_subscription.sql",
    "db:verify:invoices": "node scripts/db-run.mjs supabase/tests/verify_invoice_numbering.sql",
    "db:verify:storage": "node scripts/db-run.mjs supabase/tests/verify_recitation_storage_scope.sql",
    "db:verify:teachers": "node scripts/db-run.mjs supabase/tests/verify_teacher_owner_scope.sql",
    "db:verify:learning": "node scripts/db-run.mjs supabase/tests/verify_learning_writes.sql",
    "db:verify:payments": "node scripts/db-run.mjs supabase/tests/verify_payments.sql",
    "db:verify:notifications": "node scripts/db-run.mjs supabase/tests/verify_notifications.sql",
    "db:verify:admin": "node scripts/db-run.mjs supabase/tests/verify_admin_console.sql",
    "db:verify:rls": "node scripts/db-run.mjs supabase/tests/verify_rls_equivalence.sql",
    "db:verify:consent": "node scripts/db-run.mjs supabase/tests/verify_ai_consent.sql",
    "db:verify:ijazah": "node scripts/db-run.mjs supabase/tests/verify_ijazah.sql",
    "db:verify:heatmap": "node scripts/db-run.mjs supabase/tests/verify_heatmap.sql",
    "db:verify:signals": "node scripts/db-run.mjs supabase/tests/verify_teacher_signals.sql",
    "db:seed": "node scripts/seed-remote.mjs",
    "db:check-auth": "node scripts/check-supabase-auth.mjs",
    "db:types": "npx supabase gen types typescript --project-id rblnistltccysizdcnvt > packages/shared/src/database.types.ts",
    "db:check-admin": "node scripts/check-admin-guard.mjs",
    "grant-admin": "node scripts/grant-admin.mjs",
    "ai:dev": "node --env-file=services/ai-gateway/.env --watch services/ai-gateway/src/server.ts",
    "ai:start": "node --env-file=services/ai-gateway/.env services/ai-gateway/src/server.ts",
    "ai:check": "node scripts/check-ai-gateway.mjs",
    "ai:check:hosted": "node scripts/check-ai-gateway.mjs --hosted",
    "check:tajweed": "node scripts/check-tajweed.mjs",
    "check:card": "node scripts/check-card.mjs",
    "usability:score": "node scripts/usability-score.mjs",
    "db:seed:learning": "node scripts/seed-learning-data.mjs",
    "ai:url": "node scripts/set-gateway-url.mjs",
    "check:screens": "node scripts/check-screens.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "db:seed:ops": "node scripts/seed-operations.mjs",
    "db:query": "node scripts/db-query.mjs",
    "db:backup": "node scripts/db-backup.mjs",
    "db:restore": "node scripts/db-restore.mjs",
    "db:storage": "node scripts/setup-storage.mjs",
    "check:functions": "node scripts/check-functions.mjs",
    "check:learning": "node scripts/check-learning.mjs",
    "check:payments": "node scripts/check-payments.mjs",
    "check:notifications": "node scripts/check-notifications.mjs",
    "perf:api": "node scripts/perf-api.mjs",
    "perf:db": "node scripts/perf-db.mjs",
    "quran:build": "node scripts/build-quran-juz.mjs",
    "quran:publish": "node scripts/publish-quran.mjs",
    "check:storage": "node scripts/check-storage.mjs",
    "check:build-config": "node scripts/check-build-config.mjs"
  },
  "engines": {
    "node": ">=20.19.4"
  },
  "devDependencies": {
    "vitest": "^4.1.11"
  }
}
