# ============================================================================
# Digital Madrasa — mobile app environment
# ============================================================================
#
# Copy to `.env` and fill in. `.env` is gitignored; this file is not.
#
#   cp .env.example .env
#
# ----------------------------------------------------------------------------
# READ THIS BEFORE ADDING A VARIABLE
# ----------------------------------------------------------------------------
# Anything prefixed EXPO_PUBLIC_ is INLINED INTO THE APP BUNDLE at build time.
# Anyone who downloads the APK can unzip it and read the value. It is public.
#
# Therefore the following must NEVER appear in this file or in `.env`:
#
#   - SUPABASE_SERVICE_ROLE_KEY  (bypasses every RLS policy)  secret-scan-ok
#   - M-Pesa consumer key/secret, passkey, shortcode
#   - RESEND_API_KEY, Africa's Talking key, or any SMTP password
#   - Anything starting `sb_secret_`
#
# Those live in Supabase Edge Function secrets — see supabase/.env.example.
# CI greps this directory for them and fails the build.
#
# The anon key IS safe here: it carries no privileges of its own and every
# request it makes is still evaluated by RLS.
# ============================================================================

# --- API mode ---------------------------------------------------------------
# "mock"     — in-memory demo data, no network. Current default.
# "supabase" — real backend. Requires the two Supabase values below.
EXPO_PUBLIC_API_MODE=mock

# --- Supabase ---------------------------------------------------------------
# Project settings → API. Use the anon/publishable key, never service_role.  secret-scan-ok
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Monitoring (optional) --------------------------------------------------
# Sentry DSNs are designed to be public — they only accept event submissions.
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# --- Environment label ------------------------------------------------------
# development | staging | production. Tags Sentry releases and gates debug UI.
EXPO_PUBLIC_ENV=development

# Leave empty to use the hosted assistant (the ai-assistant Edge Function).
# Set it only to use a self-hosted gateway; on a phone that must be your
# machine's LAN IP, not 127.0.0.1 — localhost on the handset is the handset.
EXPO_PUBLIC_AI_GATEWAY_URL=
