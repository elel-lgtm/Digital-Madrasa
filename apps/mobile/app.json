{
  "expo": {
    "name": "ILMORA",
    "slug": "digital-madrasa",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "digitalmadrasa",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0E3B3A",
    "primaryColor": "#C9A227",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.digitalmadrasa.mobile",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "ILMORA records your recitation so your teacher and the tajweed assistant can give you feedback.",
        "NSCameraUsageDescription": "The camera is used to scan the attendance QR code shown by your teacher."
      },
      "buildNumber": "1"
    },
    "android": {
      "package": "app.digitalmadrasa.mobile",
      "edgeToEdgeEnabled": true,
      "permissions": [
        "RECORD_AUDIO",
        "CAMERA",
        "VIBRATE",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.CAMERA"
      ],
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/adaptive-icon-monochrome.png",
        "backgroundColor": "#0E3B3A"
      }
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      "expo-secure-store",
      "expo-font",
      "expo-notifications",
      [
        "expo-audio",
        {
          "microphonePermission": "ILMORA records your recitation so your teacher and the tajweed assistant can give you feedback."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "The camera is used to scan the attendance QR code shown by your teacher."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "ILMORA records your recitation so your teacher and the tajweed assistant can give you feedback.",
          "speechRecognitionPermission": "Recite-along listens while you recite so it can follow your place in the surah.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.as"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0E3B3A",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#0A2B2A"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "eas": {
        "projectId": "da47a3f7-f339-482e-997d-dc4889a9e96d"
      },
      "router": {}
    },
    "owner": "el_noury7",
    "icon": "./assets/images/icon.png",
    "web": {
      "favicon": "./assets/images/favicon.png"
    }
  }
}
